{
  "name": "lambdaidx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed.mjs",
    "backend:bootstrap": "pnpm run infra:up && pnpm run db:push && pnpm run db:seed",
    "search:reindex": "node scripts/reindex-search.mjs",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "admin:create": "npx tsx scripts/create-admin.ts"
  },
